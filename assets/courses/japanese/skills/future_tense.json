{
  "id": "future_tense",
  "name": "Future Intentions & Volitional Form",
  "description": "Express future plans, intentions with 〜つもり and the volitional form (〜よう)",
  "level": 14,
  "exercises": [
    {
      "id": "ex_ja_future_tense_1",
      "type": "multipleChoice",
      "question": "Which phrase expresses 'I intend to study abroad next year'?",
      "options": [
        "来年留学するつもりです",
        "来年留学しました",
        "来年留学したことがあります",
        "来年留学してください"
      ],
      "correctAnswer": "来年留学するつもりです",
      "targetLanguage": "ja-JP",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_ja_future_tense_2",
