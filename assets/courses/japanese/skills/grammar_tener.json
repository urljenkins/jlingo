  "exercises": [
    {
      "id": "ex_ja_grammar_tener_1",
      "type": "multipleChoice",
      "question": "Which phrase expresses 'I have a car' using 持つ (motsu)?",
      "options": [
        "車を持っています",
        "車を着ています",
        "車を乗っています",
        "車を行きます"
      ],
      "correctAnswer": "車を持っています",
      "targetLanguage": "ja-JP",
      "nativeLanguage": "en-US"
    },
