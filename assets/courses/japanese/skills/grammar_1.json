      "question": "Which particle means 'also' or 'too'?",
      "options": [
        "も",
        "は",
        "が",
        "で"
      ],
      "correctAnswer": "も",
      "targetLanguage": "ja-JP",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_ja_grammar_1_2",
      "type": "translateThis",
      "question": "私も学生です",
      "options": [],
      "correctAnswer": "I am also a student",
      "targetLanguage": "ja-JP",
      "nativeLanguage": "en-US",
      "acceptableAnswers": [
        "I am a student too",
        "I'm also a student",
        "I am also a student"
      ]
    },
