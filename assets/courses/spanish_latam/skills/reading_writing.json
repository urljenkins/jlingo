            "id": "rw_story_1",
            "type": "storyLesson",
            "question": "¿Qué vio María en el parque?",
            "options": [
                "Un gato negro",
                "Un perro grande",
                "Un pájaro azul",
                "Una mariposa"
            ],
            "correctAnswer": "Un gato negro",
            "targetLanguage": "es-ES",
            "nativeLanguage": "en-US",
            "metadata": {
                "title": "El Gato del Parque",
                "level": "A1",
                "story": "María caminaba por el parque en un día soleado. Los pájaros cantaban en los árboles y el viento era suave. De repente, vio un gato negro sentado en un banco. El gato tenía ojos verdes muy brillantes. María se acercó lentamente y el gato empezó a ronronear. Desde ese día, María visita el parque todos los días para ver a su nuevo amigo.",
                "vocabulary": [
                    {
                        "word": "caminaba",
                        "translation": "was walking",
                        "highlight": true
                    },
                    {
                        "word": "soleado",
                        "translation": "sunny",
                        "highlight": true
                    },
                    {
                        "word": "gato",
                        "translation": "cat",
                        "highlight": true
                    },
                    {
                        "word": "ojos",
                        "translation": "eyes",
                        "highlight": true
                    },
                    {
                        "word": "ronronear",
                        "translation": "to purr",
                        "highlight": true
                    }
                ],
                "question": "¿Qué vio María en el parque?"
            }
        },
