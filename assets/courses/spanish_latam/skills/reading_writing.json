            "metadata": {
                "title": "El Gato del Parque",
                "level": "A1",
                "story": "María camina por el parque. Hace sol y los pájaros cantan en los árboles. En un banco hay un gato negro. El gato tiene los ojos verdes. María camina despacio hacia el banco y el gato ronronea. Ahora María visita el parque todos los días para ver a su nuevo amigo.",
                "vocabulary": [
                    {
                        "word": "camina",
                        "translation": "walks",
                        "highlight": true
                    },
                    {
                        "word": "hace sol",
                        "translation": "it's sunny",
                        "highlight": true
                    },
                    {
                        "word": "gato",
                        "translation": "cat",
                        "highlight": true
                    },
                    {
                        "word": "ojos",
                        "translation": "eyes",
                        "highlight": true
                    },
                    {
                        "word": "ronronea",
                        "translation": "purrs",
                        "highlight": true
                    }
                ],
                "question": "¿Qué ve María en el parque?"
            }
