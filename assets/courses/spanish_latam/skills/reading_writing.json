        {
            "id": "rw_story_3",
            "type": "storyLesson",
            "question": "¿Qué tiempo hacía cuando Ana salió de casa?",
            "options": [
                "Estaba lloviendo",
                "Hacía sol",
                "Estaba nevando",
                "Hacía viento"
            ],
            "correctAnswer": "Estaba lloviendo",
            "targetLanguage": "es-ES",
            "nativeLanguage": "en-US",
            "metadata": {
                "title": "Un Día de Lluvia",
                "level": "A2",
                "story": "Ana se despertó temprano por la mañana. Cuando miró por la ventana, vio que estaba lloviendo mucho. Decidió llevar su paraguas azul. Caminó hacia la parada del autobús mientras escuchaba la lluvia caer. En el autobús, conoció a una señora mayor que había olvidado su paraguas. Ana, siendo muy amable, compartió su paraguas con ella hasta la siguiente parada.",
                "vocabulary": [
                    {
                        "word": "lloviendo",
                        "translation": "raining",
                        "highlight": true
                    },
                    {
                        "word": "paraguas",
                        "translation": "umbrella",
                        "highlight": true
                    },
                    {
                        "word": "parada",
                        "translation": "stop/station",
                        "highlight": true
                    },
                    {
                        "word": "señora",
                        "translation": "lady/woman",
                        "highlight": true
                    },
                    {
                        "word": "compartió",
                        "translation": "shared",
                        "highlight": true
                    }
                ],
                "question": "¿Qué tiempo hacía cuando Ana salió de casa?"
            }
        },
