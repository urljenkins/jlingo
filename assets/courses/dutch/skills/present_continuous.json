      "id": "ex_nl_pc_1",
      "type": "multipleChoice",
      "question": "How is the present continuous ('to be doing something') typically formed in Dutch?",
      "options": [
        "zijn + aan het + infinitive (ik ben aan het lezen)",
        "zijn + gerundium (-ing)",
        "hebben + voltooid deelwoord",
        "gaan + infinitive"
