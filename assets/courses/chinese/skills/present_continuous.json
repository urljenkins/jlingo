{
  "id": "present_continuous",
  "name": "Present Continuous",
  "description": "Learn ongoing actions using 正在 (zhèngzài) and the aspect particle 呢 (ne)",
  "level": 12,
  "exercises": [
    {
      "id": "ex_zh_pc_1",
      "type": "multipleChoice",
      "question": "Which marker is placed before a verb in Chinese to express the ongoing continuous aspect (-ing)?",
      "options": [
        "正在 (zhèngzài)",
        "已经 (yǐjīng)",
        "曾经 (céngjīng)",
        "就要 (jiùyào)"
      ],
      "correctAnswer": "正在 (zhèngzài)",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_pc_2",
      "type": "translateThis",
