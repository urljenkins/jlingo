      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_cnd_3",
      "type": "fillInBlank",
      "question": "要是明天下雨，我们 ___ 不去爬山了。(then)",
