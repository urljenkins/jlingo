      "type": "multipleChoice",
      "question": "What is the standard pair for 'If ... then ...' in Chinese?",
      "options": [
        "如果 ... 就 ... (rúguǒ ... jiù ...)",
        "虽然 ... 但是",
        "因为 ... 所以",
        "只要 ... 却"
      ],
      "correctAnswer": "如果 ... 就 ... (rúguǒ ... jiù ...)",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_cnd_2",
