      "type": "multipleChoice",
      "question": "In basic Chinese, which adverb is customary when linking a subject to an adjective predicate (e.g. 'He is tall')?",
      "options": [
        "很 (hěn)",
        "是 (shì)",
        "有 (yǒu)",
        "在 (zài)"
      ],
      "correctAnswer": "很 (hěn)",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
