  "exercises": [
    {
      "id": "ex_zh_pt1_1",
      "type": "multipleChoice",
      "question": "Which particle is placed after a verb in Chinese to indicate completion of an action?",
      "options": [
        "了 (le)",
        "过 (guo)",
        "着 (zhe)",
        "的 (de)"
      ],
      "correctAnswer": "了 (le)",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
