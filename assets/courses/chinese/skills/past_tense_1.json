{
  "id": "past_tense_1",
  "name": "Past Tense: Preterite",
  "description": "Learn completed action markers with particle 了 (le) and past time words",
  "level": 12,
  "exercises": [
    {
      "id": "ex_zh_pt1_1",
      "type": "multipleChoice",
      "question": "Which particle is placed after a verb in Chinese to indicate completion of an action?",
      "options": [
        "了 (le)",
        "过 (guo)",
        "着 (zhe)",
        "的 (de)"
      ],
      "correctAnswer": "了 (le)",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_pt1_2",
      "type": "translateThis",
      "question": "我昨天买了一本书",
      "options": [],
      "correctAnswer": "I bought a book yesterday",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_pt1_3",
      "type": "fillInBlank",
      "question": "他吃 ___ 晚饭就出去了。(He ate dinner and then went out.)",
      "options": [
        "了",
        "吗",
        "呢",
        "把"
      ],
      "correctAnswer": "了",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
