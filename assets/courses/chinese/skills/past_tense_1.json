      "id": "ex_zh_pt1_7",
      "type": "multipleChoice",
      "question": "What does the aspect particle \"了\" (le) directly after a verb signify?",
      "options": [
        "Completion or realization of an action (perfective aspect)",
        "Future certainty only",
        "Continuous repetition indefinitely",
        "Negation of past events"
      ],
      "correctAnswer": "Completion or realization of an action (perfective aspect)"
    },
