{
  "id": "grammar_1",
  "name": "Grammar: Pronouns",
  "description": "Learn personal pronouns (I, you, he, she, we, they) and the plural suffix 们 (men)",
  "level": 2,
  "exercises": [
    {
      "id": "ex_zh_gr1_1",
      "type": "multipleChoice",
      "question": "Which suffix is added to personal pronouns to make them plural in Chinese?",
      "options": [
        "们 (men)",
        "的 (de)",
        "个 (ge)",
        "了 (le)"
      ],
      "correctAnswer": "们 (men)",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_gr1_2",
      "type": "translateThis",
      "question": "我们",
      "options": [],
