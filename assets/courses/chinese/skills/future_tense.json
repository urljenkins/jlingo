{
  "id": "future_tense",
  "name": "Future Tense",
  "description": "Learn to express future intent, plans, and events using 要 (yào), 会 (huì), and 将 (jiāng)",
  "level": 14,
  "exercises": [
    {
      "id": "ex_zh_ft_1",
      "type": "multipleChoice",
      "question": "Which modal verb frequently indicates future likelihood or 'will' in Chinese?",
      "options": [
        "会 (huì)",
        "在 (zài)",
        "过 (guo)",
        "了 (le)"
      ],
      "correctAnswer": "会 (huì)",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_ft_2",
      "type": "translateThis",
      "question": "明天会下雨",
      "options": [],
      "correctAnswer": "It will rain tomorrow",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_ft_3",
      "type": "fillInBlank",
      "question": "我打算下个月 ___ 中国。(I plan to go to China next month.)",
      "options": [
        "去",
        "是",
        "在",
        "做"
      ],
      "correctAnswer": "去",
      "targetLanguage": "zh-CN",
      "nativeLanguage": "en-US"
    },
    {
      "id": "ex_zh_ft_4",
